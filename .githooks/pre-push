#!/usr/bin/env bash
# Pre-push hook: bail before any commits reach the remote if the tree
# would fail CI. Mirrors what .github/workflows/ci.yml runs in the
# "fmt + clippy" job. Bypass with `git push --no-verify` if you need
# to push something known-broken (e.g. a WIP branch).
#
# Tracked in the repo rather than living in .git/hooks, which is local
# state that no clone inherits. Activate with:
#
#     git config core.hooksPath .githooks
#
# Without that one command a fresh clone has no gates at all, and the
# failure is silent — pushes just succeed. See "Building from Source"
# in README.md.
#
# NOT covered here, on purpose: the MSRV build. Compiling the workspace
# on a second toolchain would add minutes to every push for a rare
# failure, so the `MSRV 1.88` CI job owns that. What this *does* check is
# that the MSRV strings agree with each other, via check-release-versions.sh.

set -euo pipefail

# Hooks run from the top of the working tree, but be explicit so the
# scripts/ paths below still resolve under `git worktree`.
cd "$(git rev-parse --show-toplevel)"

# git feeds the refs being pushed on stdin, one per line:
#   <local ref> <local sha> <remote ref> <remote sha>
# Read it up front: it can only be consumed once, and the checks below run
# commands that would otherwise swallow it.
pushed_refs="$(cat)"

# Colour helpers — silenced when stdout isn't a terminal.
if [ -t 1 ]; then
    RED="\033[31m"
    GREEN="\033[32m"
    YELLOW="\033[33m"
    RESET="\033[0m"
else
    RED=""; GREEN=""; YELLOW=""; RESET=""
fi

# Private temp file rather than a fixed /tmp path: this hook now runs on
# other people's machines, where a predictable name in a shared /tmp is
# someone else's to collide with or pre-create as a symlink.
clippy_log=$(mktemp -t stet-clippy.XXXXXX)
trap 'rm -f "$clippy_log"' EXIT

echo -e "${YELLOW}pre-push: cargo fmt --check${RESET}"
if ! cargo fmt --all -- --check; then
    echo -e "${RED}pre-push: fmt failed. Run 'cargo fmt --all' and re-push.${RESET}" >&2
    exit 1
fi

echo -e "${YELLOW}pre-push: cargo clippy (errors only — warnings don't gate)${RESET}"
if ! cargo clippy --workspace --all-targets --quiet 2>&1 | tee "$clippy_log"; then
    if grep -q "^error" "$clippy_log"; then
        echo -e "${RED}pre-push: clippy errors. See output above.${RESET}" >&2
        exit 1
    fi
fi

echo -e "${YELLOW}pre-push: non-exhaustive marker audit${RESET}"
if ! scripts/check-non-exhaustive.sh; then
    echo -e "${RED}pre-push: missing #[non_exhaustive] on a stable-extension-point enum.${RESET}" >&2
    echo -e "${RED}        See docs/PLAN-NON-EXHAUSTIVE.md and the policy in CLAUDE.md.${RESET}" >&2
    exit 1
fi

echo -e "${YELLOW}pre-push: crate independence audit${RESET}"
if ! scripts/check-crate-independence.sh; then
    echo -e "${RED}pre-push: the PS and PDF-reading halves are no longer${RESET}" >&2
    echo -e "${RED}        independently usable. A PDF-only consumer must not${RESET}" >&2
    echo -e "${RED}        link the PostScript VM, and a PostScript-only consumer${RESET}" >&2
    echo -e "${RED}        must not link the PDF parser; see CLAUDE.md.${RESET}" >&2
    exit 1
fi

echo -e "${YELLOW}pre-push: VM level-zero allocation audit${RESET}"
if ! scripts/check-level-zero-alloc.sh; then
    echo -e "${RED}pre-push: operator code allocating at save level 0.${RESET}" >&2
    echo -e "${RED}        Use stet_ops::vm_ops::alloc_* instead; see the policy in CLAUDE.md.${RESET}" >&2
    exit 1
fi

echo -e "${YELLOW}pre-push: release-version + MSRV cross-check${RESET}"
if ! scripts/check-release-versions.sh; then
    echo -e "${RED}pre-push: version or MSRV strings disagree across Cargo.toml,${RESET}" >&2
    echo -e "${RED}        README badges, CHANGELOG.md, and .github/workflows/ci.yml.${RESET}" >&2
    exit 1
fi

echo -e "${YELLOW}pre-push: CLI documentation cross-check${RESET}"
if ! scripts/check-cli-docs.sh; then
    echo -e "${RED}pre-push: a CLI option is undocumented.${RESET}" >&2
    echo -e "${RED}        crates/stet-cli/README.md is what crates.io renders,${RESET}" >&2
    echo -e "${RED}        so a flag missing there is invisible to anyone deciding${RESET}" >&2
    echo -e "${RED}        whether to install stet.${RESET}" >&2
    exit 1
fi

# The wasm32 build is not part of CI's lint job, but it is the one target
# where a change compiles everywhere else and fails here: `usize` is 32-bit,
# so a `usize` constant over 4 GiB is a const-eval error rather than a
# warning. That is exactly how the 8 GiB VM default broke stet-core for
# wasm32 and went unnoticed for several commits, because the branch had not
# been pushed and CI's `wasm32 build` job never ran.
#
# Skipped with a warning rather than failing when the target is absent: not
# every contributor has it installed, and a confusing rustup error is a worse
# outcome than an unchecked push.
if rustup target list --installed 2>/dev/null | grep -qx wasm32-unknown-unknown; then
    echo -e "${YELLOW}pre-push: wasm32 cross-compile${RESET}"
    if ! (cd crates/stet-wasm && cargo check --target wasm32-unknown-unknown --release --quiet); then
        echo -e "${RED}pre-push: stet-wasm does not build for wasm32-unknown-unknown.${RESET}" >&2
        echo -e "${RED}        usize is 32-bit there — check for oversized constants.${RESET}" >&2
        exit 1
    fi
else
    echo -e "${YELLOW}pre-push: wasm32 target not installed, skipping cross-compile${RESET}"
    echo -e "${YELLOW}        rustup target add wasm32-unknown-unknown${RESET}"
fi

# Release-tag gate. The `v*` namespace is reserved for releases, and this is
# the check that stops a bad tag leaving the machine — `check-tags.sh` audits
# what already exists, but only this sees what is being pushed right now.
#
# Written because `v0.6.1-perf` and `v0.6.2-perf` sat in the tag list for
# months, both pointing at one commit from when the workspace was 0.1.0,
# making it look as though 0.6.0 had shipped and been superseded twice.
#
# Deliberately not checked against the *current* workspace version: `git push
# --tags` re-offers every old tag, and those legitimately name earlier
# versions. What is enforced is the shape, and that the version was written up.
tag_errors=0
while read -r local_ref _local_sha _remote_ref _remote_sha; do
    case "$local_ref" in
        refs/tags/v*) ;;
        *) continue ;;
    esac
    tag="${local_ref#refs/tags/}"
    if ! [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo -e "${RED}pre-push: '$tag' is not a release tag but claims the v* namespace.${RESET}" >&2
        echo -e "${RED}        Use perf/<name> or exp/<name> for benchmarks and experiments.${RESET}" >&2
        tag_errors=$((tag_errors + 1))
        continue
    fi
    if ! grep -q "^## \[${tag#v}\]" CHANGELOG.md; then
        echo -e "${RED}pre-push: '$tag' has no '## [${tag#v}]' entry in CHANGELOG.md.${RESET}" >&2
        tag_errors=$((tag_errors + 1))
    fi
done <<< "$pushed_refs"
if [ "$tag_errors" -ne 0 ]; then
    exit 1
fi

echo -e "${YELLOW}pre-push: tag namespace audit${RESET}"
if ! scripts/check-tags.sh; then
    echo -e "${RED}pre-push: a v* tag is malformed or undocumented.${RESET}" >&2
    exit 1
fi

echo -e "${GREEN}pre-push: OK${RESET}"
