%% File Operators tests (supplementary)
%% Tests for read, readline, fileposition, flushfile, filenameforall, line
%% Fills gaps not covered by file_tests.ps

userdict /$unittest known not {(unit_tests/unittest.ps) run} if


%% =============================================================================
%% read - byte-by-byte reading
%% =============================================================================

% Create test file
(ft_read_test.txt) (w) file dup (ABC) writestring closefile

%% read - basic byte reading %%
(ft_read_test.txt) (r) file /rf exch def
rf /read [65 true] assert    % 'A'
rf /read [66 true] assert    % 'B'
rf /read [67 true] assert    % 'C'
rf /read [false] assert      % EOF
rf closefile

%% read - error conditions %%
/read [/stackunderflow] assert
123 /read [123 /typecheck] assert
(string) /read [(string) /typecheck] assert


%% =============================================================================
%% readline - read lines from file
%% =============================================================================

% Create test file with newlines
(ft_readline_test.txt) (w) file dup
(Line1\nLine2\nLine3) writestring closefile

%% readline - basic line reading %%
(ft_readline_test.txt) (r) file /rf exch def
rf 100 string /readline [(Line1) true] assert
rf 100 string /readline [(Line2) true] assert
rf 100 string /readline [(Line3) false] assert  % Last line, no trailing newline
rf closefile

%% readline - error conditions %%
/readline [/stackunderflow] assert
123 string /readline [123 string /stackunderflow] assert
123 100 string /readline [123 100 string /typecheck] assert

% Clean up
(ft_read_test.txt) deletefile
(ft_readline_test.txt) deletefile


%% =============================================================================
%% fileposition - track position after reads
%% =============================================================================

% Create test file
(ft_pos_test.txt) (w) file dup (0123456789) writestring closefile

%% fileposition - basic tracking %%
(ft_pos_test.txt) (r) file /rf exch def
rf /fileposition [0] assert
rf 3 string readstring pop pop
rf /fileposition [3] assert
rf 5 string readstring pop pop
rf /fileposition [8] assert
rf closefile

%% fileposition - error conditions %%
/fileposition [/stackunderflow] assert
123 /fileposition [123 /typecheck] assert

% Clean up
(ft_pos_test.txt) deletefile


%% =============================================================================
%% flushfile - discard remaining data
%% =============================================================================

% Create test file
(ft_flush_test.txt) (w) file dup (Hello World) writestring closefile

%% flushfile - discards remaining data on read file %%
(ft_flush_test.txt) (r) file /rf exch def
rf 5 string readstring pop pop    % Read "Hello"
rf flushfile                       % Discard rest
% File should be at EOF / closed after flushfile
rf /read [false] assert

%% flushfile - error conditions %%
/flushfile [/stackunderflow] assert
123 /flushfile [123 /typecheck] assert

% Clean up
(ft_flush_test.txt) deletefile


%% =============================================================================
%% filenameforall - enumerate files
%% =============================================================================

%% filenameforall - find at least one file %%
/fn_count 0 def
(unit_tests/*.ps) { pop /fn_count fn_count 1 add def } 100 string filenameforall
fn_count 0 gt [true] assert

%% filenameforall - pattern matching %%
% Should find the unittest.ps file
/found_unittest false def
(unit_tests/unittest.ps) {
    (unit_tests/unittest.ps) eq { /found_unittest true def } if
} 100 string filenameforall
found_unittest [true] assert

%% filenameforall - error conditions %%
/filenameforall [/stackunderflow] assert
(*) {} /filenameforall [(*) {} /stackunderflow] assert


%% =============================================================================
%% write - single byte write
%% =============================================================================

% Create file and write individual bytes
(ft_write_test.txt) (w) file /wf exch def
wf 72 write     % 'H'
wf 105 write    % 'i'
wf closefile

% Verify
(ft_write_test.txt) (r) file /rf exch def
rf 10 string readstring [(Hi) false] assert
rf closefile

%% write - error conditions %%
/write [/stackunderflow] assert
123 /write [123 /stackunderflow] assert
(str) 65 /write [(str) 65 /typecheck] assert

% Clean up
(ft_write_test.txt) deletefile


%% =============================================================================
%% closefile
%% =============================================================================

%% closefile - basic %%
(ft_close_test.txt) (w) file /wf exch def
wf (test) writestring
wf /closefile [] assert

%% closefile - error conditions %%
/closefile [/stackunderflow] assert
123 /closefile [123 /typecheck] assert

% Clean up
(ft_close_test.txt) deletefile


%% =============================================================================
%% deletefile
%% =============================================================================

%% deletefile - basic %%
(ft_del_test.txt) (w) file dup (temp) writestring closefile
% status returns: pages bytes ref created true (or false)
% Keep the bool (top of stack), discard the 4 integers below it
{(ft_del_test.txt) status 5 1 roll pop pop pop pop} [true] assert
(ft_del_test.txt) deletefile
{(ft_del_test.txt) status} [false] assert

%% deletefile - error conditions %%
/deletefile [/stackunderflow] assert
123 /deletefile [123 /typecheck] assert


%% =============================================================================
%% line - current line number
%% =============================================================================

%% line - returns an integer %%
currentfile line type /integertype eq [true] assert

%% line - value is positive %%
currentfile line 0 gt [true] assert


%% =============================================================================
%% end of file closes the file (PLRM 3e `file`: "closed ... implicitly (by
%% encountering end-of-file while reading or executing the file)").
%% Expected values are Ghostscript 10.05's.
%% =============================================================================

(ft_eof_test.txt) (w) file dup (abc) writestring closefile
(ft_eof_test.ps) (w) file dup (1 2 add pop\n) writestring closefile
(ft_eof_hex.txt) (w) file dup (616263) writestring closefile
(ft_eof_lines.txt) (w) file dup (ab\ncd) writestring closefile

%% eof - each read path closes the file it reads %%
{(ft_eof_test.txt) (r) file dup 10 string readstring pop pop status} [false] assert
{(ft_eof_test.txt) (r) file 3 {dup read pop pop} repeat dup read exch status} [false false] assert
{(ft_eof_test.txt) (r) file dup 10 string readline pop pop status} [false] assert
{(ft_eof_hex.txt) (r) file dup 10 string readhexstring pop pop status} [false] assert
{(ft_eof_test.ps) (r) file {dup token {pop} {exit} ifelse} loop status} [false] assert
{(ft_eof_test.ps) (r) file dup cvx exec status} [false] assert
{(616263>) /ASCIIHexDecode filter dup 10 string readstring pop pop status} [false] assert

%% eof - a read that stops short of the end leaves the file open %%
{(ft_eof_test.txt) (r) file dup 3 string readstring pop pop status} [true] assert
{(ft_eof_lines.txt) (r) file dup 10 string readline pop pop status} [true] assert

%% eof - a filter reading its source to the end leaves the source open %%
{(ft_eof_hex.txt) (r) file dup /ASCIIHexDecode filter 10 string readstring pop pop status} [true] assert

%% eof - ReusableStreamDecode reads its source to the end, closing it %%
{(ft_eof_hex.txt) (r) file dup /ReusableStreamDecode filter pop status} [false] assert

%% eof - reading again after the end answers end of file, not ioerror %%
{(ft_eof_test.txt) (r) file dup 10 string readstring pop pop 10 string readstring exch length} [false 0] assert
{(ft_eof_test.txt) (r) file dup 10 string readstring pop pop dup read exch bytesavailable} [false -1] assert
{(ft_eof_test.txt) (r) file dup closefile 10 string readstring exch length} [false 0] assert

%% eof - the standard files stay open %%
{(%stdin) (r) file status} [true] assert

(ft_eof_test.txt) deletefile
(ft_eof_test.ps) deletefile
(ft_eof_hex.txt) deletefile
(ft_eof_lines.txt) deletefile


%% =============================================================================
%% file VM: a file object is local or global like any composite, and
%% `restore` closes the local files made since its `save` (PLRM 3e `file`).
%% Expected values are Ghostscript 10.05's, except `currentfile`, which stet
%% makes local (a global job file could never be reclaimed).
%% =============================================================================

(ft_vm_test.txt) (w) file dup (616263) writestring closefile

%% file vm - gcheck follows currentglobal; the standard files are global %%
{(ft_vm_test.txt) (r) file gcheck} [false] assert
{true setglobal (ft_vm_test.txt) (r) file false setglobal gcheck} [true] assert
{(%stdout) (w) file gcheck (%stdin) (r) file gcheck} [true true] assert

%% file vm - a filter over a local file is local, even in global VM %%
{true setglobal (61>) /ASCIIHexDecode filter false setglobal gcheck} [true] assert
{(ft_vm_test.txt) (r) file true setglobal /ASCIIHexDecode filter false setglobal gcheck} [false] assert

%% file vm - a local file cannot go into a global array (PLRM 3.7.2) %%
{true setglobal 1 array false setglobal 0 (ft_vm_test.txt) (r) file {put} stopped pop
 3 {pop} repeat $error /errorname get $error /newerror false put} [/invalidaccess] assert
{true setglobal 1 array dup 0 (ft_vm_test.txt) (r) file put false setglobal 0 get gcheck} [true] assert

%% file vm - a global file made inside a save survives its restore, open %%
{true setglobal 1 array false setglobal
 save exch dup 0 true setglobal (ft_vm_test.txt) (r) file false setglobal put exch restore
 0 get status} [true] assert

%% file vm - restore closes, and flushes, a local file made since the save %%
{save (ft_vm_out.txt) (w) file (xyz) writestring restore
 (ft_vm_out.txt) (r) file 10 string readstring pop} [(xyz)] assert

%% file vm - a local file newer than the save on the stack: invalidrestore %%
{/ft_vm_sv save def (ft_vm_test.txt) (r) file {ft_vm_sv restore} stopped
 3 1 roll pop pop $error /errorname get $error /newerror false put ft_vm_sv restore}
 [true /invalidrestore] assert

(ft_vm_test.txt) deletefile
(ft_vm_out.txt) deletefile
