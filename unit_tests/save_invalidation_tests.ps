%% Save Object Invalidation Tests %%
% Tests that save objects become invalid after restore and cannot be reused

userdict /$unittest known not {(unit_tests/unittest.ps) run} if


%% Basic invalidation %%
% Save object should become invalid after restore
save /mysave exch def mysave restore
{ mysave restore } stopped [true] assert  % Should return true (error occurred)
clear  % Clear any error objects from stack

%%% Multiple saves with selective invalidation %%
/save1 save def /save2 save def /save3 save def
save1 restore
% save2 and save3 should be invalidated
{ save2 restore } stopped [true] assert
clear
{ save3 restore } stopped [true] assert
clear

%% Sequential restore operations %%
% Sequential restores should work properly (no errors)
/s1 null def /s2 null def /s3 null def
save /s1 exch def save /s2 exch def save /s3 exch def
{ s3 restore } stopped [false] assert  % Should work (no error)
{ s2 restore } stopped [false] assert  % Should work (no error)
{ s1 restore } stopped [false] assert  % Should work (no error)

%% Proper invalidation order %%
/sa save def /sb save def /sc save def
sb restore  % Restoring sb should invalidate sc but leave sa valid
{ sc restore } stopped [true] assert   % sc should be invalid
clear
{ sa restore } stopped [false] assert  % sa should still be valid

%% VM state changes with invalidation %%
[10 20 30] /test_array exch def
save /array_save exch def
test_array 1 99 put
test_array 1 get 99 eq [true] assert
array_save restore
test_array 1 get 20 eq [true] assert  % Should be restored
{ array_save restore } stopped [true] assert  % Save should be invalid
clear

%% Variable definition restoration %%
/test_new_var where [false] assert  % Should not exist initially
save /vm_save exch def
/test_new_var 123 def  % Create new variable in save context
/test_new_var where [userdict true] assert  % Should exist
vm_save restore
/test_new_var where [false] assert  % Should be gone after restore
{ vm_save restore } stopped [true] assert  % Save should be invalid
clear

%% Edge cases %%
% Test immediate save/restore cycle
/immediate save def 
{ immediate restore } stopped [false] assert  % Should work
{ immediate restore } stopped [true] assert   % Should fail (now invalid)
clear
{ immediate restore } stopped [true] assert   % Should still fail (still invalid)
clear


%% =============================================================================
%% restore reverts mutations to dictionaries older than the save
%%
%% PLRM 3.7.3: restore "resets the values of all composite objects in local VM,
%% except strings, to their state at the time of the save". Writes the
%% interpreter makes on a program's behalf are covered by that too -- a font or
%% resource registered inside the bracket must not survive the restore.
%% =============================================================================

% findresource leaves the key on the stack when it raises, so normalise to a
% single boolean rather than asserting on the residue.
/resgone { %def          % proc -> bool (true if the resource is gone)
    stopped { clear true } { false } ifelse
} bind def

%% restore reverts defineresource %%
/s save def
    /MyProcSet 10 dict /ProcSet defineresource pop
s restore
{ /MyProcSet /ProcSet findresource pop } resgone [true] assert

%% resources defined outside the bracket survive it %%
/KeepProcSet 10 dict /ProcSet defineresource pop
/s save def
    /DropProcSet 10 dict /ProcSet defineresource pop
s restore
{ /KeepProcSet /ProcSet findresource pop } resgone [false] assert
{ /DropProcSet /ProcSet findresource pop } resgone [true] assert

%% restore reverts a font registration in FontDirectory %%
/s save def
    /Times-Roman findfont pop
s restore
FontDirectory /Times-Roman known [false] assert

%% restore reverts an entry added to a dictionary older than the save %%
/olddict 10 dict def
olddict /before 1 put
/s save def
    olddict /during 2 put
    olddict /before 99 put
s restore
olddict /during known [false] assert
olddict /before get [1] assert

%% restore reverts an in-place reverse %%
/oldarr [1 2 3] def
/s save def
    oldarr reverse pop
s restore
oldarr 0 get [1] assert
oldarr 2 get [3] assert

%% restore reverts an execstack snapshot written into a pre-save array %%
% `execstack` and `dictstack` overwrite a caller-supplied array in place. The
% array is typically $error's, allocated once and reused by every error, so it
% is older than the save and the write has to be undoable.
/estk 20 array def
/s save def
    estk execstack pop
s restore
estk 0 get null eq [true] assert

%% restore reverts a dictstack snapshot written into a pre-save array %%
/dstk 20 array def
/s save def
    dstk dictstack pop
s restore
dstk 0 get null eq [true] assert

%% internaldict exists before any save, so restore reverts its entries %%
% `internaldict` is created during bootstrap rather than on first use:
% Context caches its EntityId for the life of the interpreter, so the dict
% must outlive every restore. Entries written into it after a save are
% still reverted, by the dict's own copy-on-write.
1183615869 internaldict /type [/dicttype] assert
1183615869 internaldict /gcheck [false] assert
/s save def
    1183615869 internaldict /probe 42 put
    1183615869 internaldict /probe known [true] assert
s restore
1183615869 internaldict /probe known [false] assert

%% the version string lives in global VM alongside systemdict %%
% systemdict is global, so anything the interpreter stores into it must be
% global too or it is a PLRM 3.7.2 violation the audit would flag.
version /gcheck [true] assert

%% a gstate object created after the save invalidates the restore %%
% PLRM 3.7.3.2: a composite in local VM newer than the snapshot, still
% reachable from a stack, makes restore fail. `gstate` objects index
% Context::gstate_store, which restore rewinds — so a surviving one would
% otherwise name a graphics state whose fonts and colour spaces are gone.
% A failed restore leaves its operands behind, so latch the result before
% clearing.
/s save def
{ gstate s restore } stopped /r exch def
clear
r [true] assert

%% a gstate object that does not survive the save leaves restore alone %%
/s save def
{ gstate pop s restore } stopped /r exch def
clear
r [false] assert

%% gstate outside any save bracket still round-trips %%
{ gsave gstate setgstate grestore } stopped /r exch def
clear
r [false] assert
