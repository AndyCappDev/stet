%!PS
% Show Variant Tests for stet
% Primary focus: cshow (zero existing tests)
% Secondary: kshow/glyphshow error conditions not in font_tests.ps

userdict /$unittest known not {(unit_tests/unittest.ps) run} if

% All tests under nulldevice with a font selected
gsave nulldevice
/Courier 12 selectfont
0 0 moveto


%% =============================================================================
%% cshow — proc called per character
%% =============================================================================

%% cshow: count calls for 5-char string %%
% cshow pushes charcode wx wy on stack (charcode deepest, wy on top), then calls proc
% We count how many times proc is called
/cshow_count 0 def
{pop pop pop /cshow_count cshow_count 1 add def} (Hello) cshow
cshow_count 5 eq [true] assert

%% cshow: proc receives correct charcode %%
% Collect charcodes pushed by cshow
/cshow_codes [] def
{
    pop pop             % pop wy and wx (top two)
    /cshow_cc exch def  % charcode (bottom)
    /cshow_codes [ cshow_codes aload pop cshow_cc ] def
} (AB) cshow
cshow_codes length 2 eq [true] assert
cshow_codes 0 get 65 eq [true] assert     % 'A' = 65
cshow_codes 1 get 66 eq [true] assert     % 'B' = 66

%% cshow: empty string (no calls) %%
/cshow_empty_count 0 def
{pop pop pop /cshow_empty_count cshow_empty_count 1 add def} () cshow
cshow_empty_count 0 eq [true] assert

%% cshow: single character %%
/cshow_single_count 0 def
{pop pop pop /cshow_single_count cshow_single_count 1 add def} (X) cshow
cshow_single_count 1 eq [true] assert

%% cshow: longer string call count %%
/cshow_long_count 0 def
{pop pop pop /cshow_long_count cshow_long_count 1 add def} (PostScript) cshow
cshow_long_count 10 eq [true] assert

%% cshow: wx is numeric (width component) %%
% For Courier (monospaced), wx should be non-zero
/cshow_wx_val 0 def
{
    pop                     % pop wy (top)
    /cshow_wx_val exch def  % save wx (middle)
    pop                     % pop charcode (bottom)
} (A) cshow
cshow_wx_val type dup /integertype eq exch /realtype eq or [true] assert

%% cshow: does not advance currentpoint (unlike show) %%
0 0 moveto
{pop pop pop} (ABC) cshow
currentpoint /cy exch def /cx exch def
cx 0 eq [true] assert
cy 0 eq [true] assert


%% cshow on a composite font hands over the character code, not the CID %%
% PLRM, cshow: when the mapping algorithm selects a CIDFont, "the character
% code from string (or its last byte, if the code is more than 1 byte long) is
% put on the stack for proc". Handing over the CID breaks the standard idiom
% `1 string dup 0 4 3 roll put ... show`, which is what `pdftops` emits for
% clipped text: any CID above 255 is a rangecheck in `put`.
/cshow_comp /Identity-H [ /Courier findfont ] composefont pop
gsave
  /cshow_comp findfont 12 scalefont setfont
  0 0 moveto
  % Identity-H maps code 0x0102 to CID 258; the byte handed to proc is 0x02.
  /cshow_cid_code -1 def
  { pop pop /cshow_cid_code exch def } <0102> cshow
  cshow_cid_code [2] assert
  % A one-byte code still arrives whole.
  /cshow_cid_code -1 def
  { pop pop /cshow_cid_code exch def } <0041> cshow
  cshow_cid_code [65] assert
grestore


%% =============================================================================
%% cshow error conditions
%% =============================================================================

%% cshow error: stackunderflow %%
0 0 moveto
/cshow [/stackunderflow] assert

%% cshow error: stackunderflow (one operand) %%
0 0 moveto
(test) /cshow [(test) /stackunderflow] assert

%% cshow error: typecheck — non-string second arg %%
0 0 moveto
{pop pop pop} 123 /cshow [{pop pop pop} 123 /typecheck] assert

%% cshow error: typecheck — non-proc first arg %%
0 0 moveto
123 (test) /cshow [123 (test) /typecheck] assert


%% =============================================================================
%% kshow additional error conditions
%% =============================================================================

%% kshow error: typecheck — non-string %%
0 0 moveto
{pop pop} 123 /kshow [{pop pop} 123 /typecheck] assert

%% kshow error: typecheck — non-proc %%
0 0 moveto
123 (test) /kshow [123 (test) /typecheck] assert

%% kshow error: stackunderflow %%
0 0 moveto
/kshow [/stackunderflow] assert


%% =============================================================================
%% glyphshow error conditions
%% =============================================================================

%% glyphshow error: stackunderflow %%
0 0 moveto
/glyphshow [/stackunderflow] assert

%% glyphshow error: nocurrentpoint %%
% glyphshow requires a current point
newpath
/A /glyphshow [/A /nocurrentpoint] assert

% Restore currentpoint for any subsequent tests
0 0 moveto


%% =============================================================================
%% charpath on a Type 3 font
%% =============================================================================
% PLRM: charpath obtains "the path for the glyph outlines that would result if
% string were shown", so for a Type 3 font the glyph procedure runs and the
% paths it would have painted become part of the current path. The paths go in
% as constructed — unclosed, and unstroked for a `stroke`, because charpath's
% own boolean operand decides whether the result gets stroked. Ghostscript
% builds exactly the same path for these three glyphs.

/T3CharPath 8 dict def
T3CharPath begin
  /FontType 3 def
  /FontMatrix [0.001 0 0 0.001 0 0] def
  /FontBBox [0 0 1000 1000] def
  /Encoding 256 array def
  0 1 255 { Encoding exch /.notdef put } for
  Encoding 65 /filled put      % A — a filled triangle
  Encoding 66 /stroked put     % B — the same three points, stroked
  Encoding 67 /blank put       % C — marks nothing at all
  /CharProcs 4 dict def
  CharProcs begin
    /.notdef { 0 0 setcharwidth } bind def
    /filled {
      1000 0 setcharwidth
      100 200 moveto 400 200 lineto 400 700 lineto fill
    } bind def
    /stroked {
      1000 0 setcharwidth
      40 setlinewidth
      100 200 moveto 400 200 lineto 400 700 lineto stroke
    } bind def
    /blank { 1000 0 setcharwidth } bind def
  end
  /BuildGlyph {
    exch /CharProcs get exch
    2 copy known not { pop /.notdef } if
    get exec
  } bind def
  /BuildChar {
    1 index /Encoding get exch get
    1 index /BuildGlyph get exec
  } bind def
end
/T3CharPath T3CharPath definefont pop

/roundedbbox { pathbbox 4 array astore { round cvi } forall } def

%% charpath on a Type 3 font appends the filled outline %%
gsave
/T3CharPath findfont 100 scalefont setfont
{ newpath 0 0 moveto (A) false charpath roundedbbox } [10 20 40 70] assert
grestore

%% charpath appends a stroked glyph's path unstroked %%
% A 40-unit line width would widen the box to 8..42 / 18..72 if the glyph's
% own `stroke` were honoured; charpath contributes the path as constructed.
gsave
/T3CharPath findfont 100 scalefont setfont
{ newpath 0 0 moveto (B) false charpath roundedbbox } [10 20 40 70] assert
grestore

%% charpath advances the current point by the glyph's width %%
gsave
/T3CharPath findfont 100 scalefont setfont
{ newpath 0 0 moveto (AB) false charpath currentpoint } [200.0 0.0] assert
grestore

%% a Type 3 glyph that marks nothing contributes no path %%
% Only the moveto that established the current point is left.
gsave
/T3CharPath findfont 100 scalefont setfont
{ newpath 0 0 moveto (C) false charpath
  0 { pop pop 1 add } { pop pop 1 add } { 6 { pop } repeat 1 add } { 1 add }
  pathforall } [1] assert
grestore

%% a Type 3 glyph that shows text contributes the shown glyph outlines %%
/T3Nested 8 dict def
T3Nested begin
  /FontType 3 def
  /FontMatrix [0.001 0 0 0.001 0 0] def
  /FontBBox [0 0 1000 1000] def
  /Encoding 256 array def
  0 1 255 { Encoding exch /.notdef put } for
  Encoding 65 /nested put
  /CharProcs 2 dict def
  CharProcs begin
    /.notdef { 0 0 setcharwidth } bind def
    /nested {
      1000 0 setcharwidth
      /Courier findfont 500 scalefont setfont
      0 0 moveto (l) show
    } bind def
  end
  /BuildGlyph {
    exch /CharProcs get exch
    2 copy known not { pop /.notdef } if
    get exec
  } bind def
  /BuildChar {
    1 index /Encoding get exch get
    1 index /BuildGlyph get exec
  } bind def
end
/T3Nested T3Nested definefont pop
gsave
/T3Nested findfont 100 scalefont setfont
{ newpath 0 0 moveto (A) false charpath roundedbbox } [4 0 26 30] assert
grestore

%% =============================================================================
%% Type 3 dispatch: BuildGlyph vs BuildChar
%% =============================================================================
% The Type 3 fonts above define both procedures, which is the PLRM 5.7.2
% compatibility idiom and hides which one the interpreter actually picks. These
% fonts define exactly one each, so the dispatch is observable.
%
% PLRM 5.7: BuildGlyph is preferred and receives the character *name*, taken
% from Encoding; BuildChar is "required for LanguageLevel 1 or if BuildGlyph is
% absent" and receives the character *code*. A font supplying only BuildGlyph
% is well-formed. Ghostscript renders all of these.

% BuildGlyph only. Records each name it is handed so the dispatch can be
% asserted, and gives every glyph the same 600-unit width.
/T3G 8 dict def
/GSeen 8 array def
/GIdx 0 def
T3G begin
  /FontType 3 def
  /FontMatrix [0.001 0 0 0.001 0 0] def
  /FontBBox [0 0 1000 1000] def
  /Encoding 256 array def
  0 1 255 { Encoding exch /.notdef put } for
  Encoding 65 /square put      % A
  Encoding 66 /bar put         % B
  /BuildGlyph {
    exch pop
    dup GSeen GIdx 3 -1 roll put
    /GIdx GIdx 1 add def
    600 0 setcharwidth
    pop
  } bind def
end
/T3G T3G definefont pop

/gseen { 0 1 GIdx 1 sub { GSeen exch get } for } def

%% show on a BuildGlyph-only Type 3 font renders %%
% Regression: this used to raise invalidfont because BuildChar was required
% unconditionally.
gsave
/T3G findfont 100 scalefont setfont
/GIdx 0 def
{ 0 0 moveto (AB) show currentpoint } [120.0 0.0] assert
grestore

%% show hands BuildGlyph the Encoding name, not the code %%
% Unencoded codes fall back to /.notdef, which every Type 3 font must handle.
gsave
/T3G findfont 100 scalefont setfont
/GIdx 0 def
{ 0 0 moveto (ABZ) show gseen } [/square /bar /.notdef] assert
grestore

%% stringwidth works on a Type 3 font %%
% Regression: stringwidth had no Type 3 branch, so it fell through to the
% Type 1 path, looked for CharStrings and raised invalidfont. There is no
% width table — the only way to learn the width is to run the procedure.
gsave
/T3G findfont 100 scalefont setfont
{ (AB) stringwidth } [120.0 0.0] assert
grestore

%% stringwidth on a Type 3 font marks nothing %%
% The glyph procedure runs for real, so the check that matters is that
% nothing it painted survives on the page.
gsave
/T3G findfont 100 scalefont setfont
newpath
{ (AB) stringwidth pop pop
  0 { pop pop 1 add } { pop pop 1 add } { 6 { pop } repeat 1 add } { 1 add }
  pathforall } [0] assert
grestore

% Restore currentpoint for any subsequent tests
0 0 moveto


grestore
