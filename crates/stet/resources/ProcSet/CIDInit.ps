%!PS-Adobe-3.0 Resource-ProcSet
%%Title: CIDInit
%%Creator: stet
%%VMusage: 4000 200
%%EndComments

% CIDInit ProcSet - provides CMap construction operators
% Used by CID-keyed font infrastructure (Adobe CMap files, CUPS output, etc.)

<<
    /Title (CID Init)
    /Version 1.0
    /Revision 0

    % ---- CMap construction operators ----

    /begincmap {
        % Mark start of CMap definition
        % The CMap dict should already be on the dict stack
    } bind

    /endcmap {
        % Finalize the CMap
        .joinmappings
        % Build a CodeMap array from collected mappings if not already present
        currentdict /CIDCharMappings known
        currentdict /CIDRangeMappings known or
        currentdict /BFCharMappings known or
        currentdict /BFRangeMappings known or {
            % Collect all mappings into a single CodeMap array
            [
                currentdict /CIDCharMappings known {
                    currentdict /CIDCharMappings get aload pop
                } if
                currentdict /CIDRangeMappings known {
                    currentdict /CIDRangeMappings get aload pop
                } if
                currentdict /BFCharMappings known {
                    currentdict /BFCharMappings get aload pop
                } if
                currentdict /BFRangeMappings known {
                    currentdict /BFRangeMappings get aload pop
                } if
            ]
            currentdict exch /CodeMap exch put
        } if
    } bind

    % arr key .appendmappings -
    % A CMap writes its entries in blocks of at most 100, and each block adds
    % to the ones before it. The blocks are kept in order under key in the
    % CMap's .MappingBlocks, and endcmap joins each key's blocks once
    % (.joinmappings): copying every earlier block at each block left a large
    % CMap's discarded copies in VM, tens of megabytes for UniJIS-UCS2-H.
    /.appendmappings {
        currentdict /.MappingBlocks known not {
            currentdict /.MappingBlocks 8 dict put
        } if
        currentdict /.MappingBlocks get
        dup 2 index known not { dup 2 index 8 dict put } if
        exch get
        dup length 3 -1 roll put
    } bind

    % - .joinmappings -
    % Put under each key .appendmappings kept blocks for one array of all of
    % them, in order, and remove .MappingBlocks.
    /.joinmappings {
        currentdict /.MappingBlocks known {
            currentdict /.MappingBlocks get {
                % key blocks
                dup 0 exch { exch pop length add } forall
                array 0
                % key blocks joined offset
                0 1 4 index length 1 sub {
                    3 index exch get
                    3 copy putinterval
                    length add
                } for
                pop exch pop
                currentdict 3 1 roll put
            } forall
            currentdict /.MappingBlocks undef
        } if
    } bind

    /begincodespacerange {
        % n begincodespacerange -
        /.codespacecount exch def
    } bind

    /endcodespacerange {
        % lo1 hi1 ... lon hin endcodespacerange -
        % Collect n pairs into CodeSpaceRange array
        .codespacecount 2 mul array astore
        /CodeSpaceRange .appendmappings
    } bind

    /usefont {
        % fontnum usefont -
        currentdict exch /CurrentFontNum exch put
    } bind

    /begincidchar {
        % n begincidchar -
        /.cidcharcount exch def
    } bind

    /endcidchar {
        % src1 dst1 ... srcn dstn endcidchar -
        .cidcharcount 2 mul array astore
        /CIDCharMappings .appendmappings
    } bind

    /begincidrange {
        % n begincidrange -
        /.cidrangecount exch def
    } bind

    /endcidrange {
        % srclo1 srchi1 dstcid1 ... srclon srhin dstcidn endcidrange -
        .cidrangecount 3 mul array astore
        /CIDRangeMappings .appendmappings
    } bind

    /beginbfchar {
        % n beginbfchar -
        /.bfcharcount exch def
    } bind

    /endbfchar {
        % src1 dst1 ... srcn dstn endbfchar -
        .bfcharcount 2 mul array astore
        /BFCharMappings .appendmappings
    } bind

    /beginbfrange {
        % n beginbfrange -
        /.bfrangecount exch def
    } bind

    /endbfrange {
        % srclo1 srchi1 dst1 ... srclon srhin dstn endbfrange -
        .bfrangecount 3 mul array astore
        /BFRangeMappings .appendmappings
    } bind

    /beginnotdefchar {
        % n beginnotdefchar -
        /.notdefcharcount exch def
    } bind

    /endnotdefchar {
        % src1 dst1 ... srcn dstn endnotdefchar -
        .notdefcharcount 2 mul array astore
        /NotDefCharMappings .appendmappings
    } bind

    /beginnotdefrange {
        % n beginnotdefrange -
        /.notdefrangecount exch def
    } bind

    /endnotdefrange {
        % srclo1 srchi1 dst1 ... srclon srhin dstn endnotdefrange -
        .notdefrangecount 3 mul array astore
        /NotDefRangeMappings .appendmappings
    } bind

    /beginusematrix {
        % fontnum beginusematrix -
        /.usematrixfontnum exch def
    } bind

    /endusematrix {
        % matrix endusematrix -
        currentdict exch .usematrixfontnum exch put
    } bind

    /usecmap {
        % name usecmap -
        /CMap findresource
        currentdict exch /UseCMap exch put
    } bind

    /StartData {
        % (Binary)|(Hex) datalength StartData -
        %   currentdict is the CIDFont dictionary being built.
        % .cid_startdata reads the glyph data out of the current file: the
        % CID map, subroutines and Type 1 charstrings the glyphs are built
        % from. Reading it is not optional either way: the blob is inline in
        % the source, so anything left unread reaches the scanner.
        .cid_startdata /GlyphData exch def
        /SubrCache 10 dict def
        CIDFontName currentdict /CIDFont defineresource pop
        end     % the CIDFont dictionary
        end     % the CIDInit ProcSet dictionary
    } bind

>> % CIDInit ProcSet dictionary
