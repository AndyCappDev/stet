% Resource category definitions for stet

currentglobal
true setglobal
    systemdict begin
        /createresourcecategory {
            %% category instancetype resourcedir resourceextension <createresourcecategory> -
            %% Must be called with vm allocation mode set to true
            currentglobal not {/createresourcecategory /invalidaccess .error} if
            /Generic /Category findresource
            dup length 4 add dict copy
            exch 1 index exch /ResourceExtension exch put
            exch 1 index exch /ResourceDir exch put

            1 index type /nulltype eq { %ifelse
                exch pop
            } {
                % define the InstanceType if it is not null
                exch 1 index exch /InstanceType exch put
            } ifelse

            1 index 1 index exch /Category exch put
            /Category defineresource pop
        } bind def
    end
setglobal

currentglobal
true setglobal

% Category itself, so `/Category /Category findresource` finds it and
% `resourceforall` over Category lists it. The resource operators handle this
% category themselves; nothing in its dictionary is called.
/Category /Generic /Category findresource dup length 1 add dict copy
dup /InstanceType /dicttype put
/Category defineresource pop

/OutputDevice /dicttype (resources/OutputDevice) (.ps) createresourcecategory

% Standard PostScript Level 2 Categories
% Load custom Font category instead of generic one
(resources/Init/fontcategory.ps) run
/Encoding /arraytype (resources/Encoding) (.ps) createresourcecategory
/Form /dicttype (resources/Form) (.ps) createresourcecategory
/Pattern /dicttype (resources/Pattern) (.ps) createresourcecategory
/ProcSet /dicttype (resources/ProcSet) (.ps) createresourcecategory
/ColorSpace /arraytype (resources/ColorSpace) (.ps) createresourcecategory

% CID Font Categories
/CMap /dicttype (resources/CMap) (.ps) createresourcecategory
/CIDFont /dicttype (resources/CIDFont) (.ps) createresourcecategory

% CIDFonts that are not present. A program embedding stet registers a
% substitute per character collection in .CIDFontSubstitutes (Ordering name ->
% CIDFont name, e.g. /Japan1 /MyMincho), as Ghostscript's cidfmap does.
% A missing CIDFont is then replaced by the substitute for its collection: the
% collection comes from the CMap when the font is named CIDFontName-CMapName,
% else from .CIDFontOrderings, the collections of well-known CIDFont names.
systemdict begin
    /.CIDFontSubstitutes 8 dict def
    /.CIDFontOrderings 64 dict begin
        [ /Ryumin-Light /GothicBBB-Medium /HeiseiMin-W3 /HeiseiKakuGo-W5 /HeiseiMaruGo-W4
          /MidashiMin-MA31 /MidashiGo-MB31 /FutoMinA101-Bold /FutoGoB101-Bold /Jun101-Light
          /KozMinPr6N-Regular /KozGoPr6N-Medium /KozMinPro-Regular /KozGoPro-Medium
          /MS-Mincho /MS-Gothic /MS-PMincho /MS-PGothic /MSMincho /MSGothic ]
        { /Japan1 def } forall
        [ /STSong-Light /STHeiti-Regular /STKaiti-Regular /STFangsong-Light /AdobeSongStd-Light
          /SimSun /SimHei /KaiTi /FangSong ]
        { /GB1 def } forall
        [ /MSung-Light /MHei-Medium /MKai-Medium /AdobeMingStd-Light /MingLiU /PMingLiU
          /DFKaiShu-SB-Estd-BF ]
        { /CNS1 def } forall
        [ /HYSMyeongJo-Medium /HYGoThic-Medium /HYRGoThic-Medium /AdobeMyungjoStd-Medium
          /Batang /Dotum /Gulim /Gungsuh ]
        { /Korea1 def } forall
    currentdict end def

    % key .cidfontsubstitute key' -- the substitute's name for a CIDFont that
    % is not present and has one, else key.
    /.cidfontsubstitute {
        dup /CIDFont resourcestatus { pop pop } {
            .CIDFontOrderings 1 index known {
                .CIDFontOrderings 1 index get
                .CIDFontSubstitutes 1 index known {
                    .CIDFontSubstitutes exch get exch pop
                } { pop } ifelse
            } if
        } ifelse
    } bind def

    % key .cidkeyedparts cidfont cmap true | false -- for a font named
    % CIDFontName-CMapName (Ryumin-Light-90ms-RKSJ-H), the CIDFont to use (it,
    % or the substitute for the CMap's collection) and the CMap. The CMap is
    % the longest suffix after a hyphen that names a CMap resource.
    /.cidkeyedparts {
        6 dict begin
        /.key exch def
        /.s .key dup type /stringtype eq { dup length string copy } { dup length string cvs } ifelse def
        /.found false def
        1 1 .s length 2 sub {
            /.i exch def
            .s .i get 45 eq {
                .s .i 1 add .s length .i sub 1 sub getinterval cvn
                dup /CMap resourcestatus {
                    pop pop /.cmap exch def /.cid .s 0 .i getinterval cvn def
                    /.found true def exit
                } { pop } ifelse
            } if
        } for
        .found {
            .cid /CIDFont resourcestatus {
                pop pop .cid
            } {
                .cmap /CMap findresource /CIDSystemInfo get
                dup type /arraytype eq { 0 get } if
                /Ordering get cvn
                .CIDFontSubstitutes 1 index known { .CIDFontSubstitutes exch get } { pop .cid .cidfontsubstitute } ifelse
            } ifelse
            dup /CIDFont resourcestatus {
                pop pop .cmap true
            } { pop false } ifelse
        } { false } ifelse
        end
    } bind def

    % key .cidkeyedfont font true | false -- the font .cidkeyedparts names,
    % composed (and so defined as a Font resource).
    /.cidkeyedfont {
        dup .cidkeyedparts {
            exch /CIDFont findresource 1 array astore composefont true
        } { pop false } ifelse
    } bind def
end

% FindResource of a CIDFont that is not present finds its substitute.
/CIDFont /Category findresource begin
    /.GenericFindResource /FindResource load def
    /FindResource { .cidfontsubstitute .GenericFindResource } bind def
end

% Font Set Category
/FontSet /dicttype (resources/FontSet) (.ps) createresourcecategory

% Level 3 Resource Categories
/IdiomSet /dicttype (resources/IdiomSet) (.ps) createresourcecategory
/ControlLanguage null (resources/ControlLanguage) (.ps) createresourcecategory
/Localization /dicttype (resources/Localization) (.ps) createresourcecategory
/PDL null (resources/PDL) (.ps) createresourcecategory
/HWOptions null (resources/HWOptions) (.ps) createresourcecategory
/InkParams /dicttype (resources/InkParams) (.ps) createresourcecategory
/TrapParams /dicttype (resources/TrapParams) (.ps) createresourcecategory

% Level 2/3 Color Management Categories
/Halftone /dicttype (resources/Halftone) (.ps) createresourcecategory
/ColorRendering /dicttype (resources/ColorRendering) (.ps) createresourcecategory

setglobal

% ============================================================
% Implicit Resource Categories
% ============================================================

currentglobal
true setglobal

systemdict begin
    /createimplicitcategory {
        currentglobal not {/createimplicitcategory /invalidaccess .error} if

        exch
        /Generic /Category findresource
        dup length 6 add dict copy
        dup 3 -1 roll /Instances exch put

        % FindResource: return key itself if valid instance
        dup /FindResource {
            Instances 1 index known not {
                Category /findresource /undefinedresource .error
            } if
        } bind put

        % ResourceStatus: return 0 0 true if valid, false if not
        dup /ResourceStatus {
            Instances 1 index known {
                pop 0 0 true
            } {
                pop false
            } ifelse
        } bind put

        % ResourceForAll: handled natively by the resourceforall operator
        % (avoids dict stack pollution when callbacks use def)

        1 index 1 index exch /Category exch put
        /Category defineresource pop
    } bind def
end

% --- Integer-keyed implicit categories ---

% FontType: supported font dictionary types. 2 is CFF (Type 2 charstrings),
% 9 and 11 are CIDFontType 0 and 2, 42 is TrueType. CIDFontType 1 (10) and
% 4 (32) are not supported.
<< 0 true 1 true 2 true 3 true 9 true 11 true 42 true >>
/FontType createimplicitcategory

% FormType
<< 1 true >>
/FormType createimplicitcategory

% ImageType
<< 1 true 3 true >>
/ImageType createimplicitcategory

% PatternType
<< 1 true 2 true >>
/PatternType createimplicitcategory

% HalftoneType
<< 1 true >>
/HalftoneType createimplicitcategory

% ColorRenderingType
<< 1 true >>
/ColorRenderingType createimplicitcategory

% FunctionType (PLRM 3e Table 3.8; type 4 is PDF only)
<< 0 true 2 true 3 true >>
/FunctionType createimplicitcategory

% ShadingType
<< 1 true 2 true 3 true 4 true 5 true 6 true 7 true >>
/ShadingType createimplicitcategory

% FMapType
<< 2 true 3 true 4 true 5 true 6 true 7 true 8 true 9 true >>
/FMapType createimplicitcategory

% --- Name-keyed implicit categories ---

% Filter: supported filter algorithms
<<
    /ASCIIHexEncode true /ASCIIHexDecode true
    /ASCII85Encode true /ASCII85Decode true
    /LZWEncode true /LZWDecode true
    /FlateEncode true /FlateDecode true
    /RunLengthEncode true /RunLengthDecode true
    /CCITTFaxEncode true /CCITTFaxDecode true
    /DCTEncode true /DCTDecode true
    /NullEncode true /SubFileDecode true /ReusableStreamDecode true
>>
/Filter createimplicitcategory

% ColorSpaceFamily
<<
    /DeviceGray true /DeviceRGB true /DeviceCMYK true
    /CIEBasedA true /CIEBasedABC true
    /CIEBasedDEF true /CIEBasedDEFG true
    /ICCBased true
    /Indexed true /Separation true /DeviceN true /Pattern true
>>
/ColorSpaceFamily createimplicitcategory

% Emulator: no emulators supported
<< >>
/Emulator createimplicitcategory

% IODevice: no %device% file names are supported
<< >>
/IODevice createimplicitcategory

% TrappingType: no trapping
<< >>
/TrappingType createimplicitcategory

setglobal
