%% pagedevice dictionary for interactive viewer

<<
    /OutputDeviceName (viewer)
    /OutputDevice /viewer
    /PageSize [612 792]
    /HWResolution [300 300]
    /Margins [0.0 0.0]
    /PageOffset [0 0]
    /BitsPerPixel 24
    /NumCopies null
    /Install {
        .9 setflat
        {} settransfer
    } bind
    /BeginPage {pop} bind
    /EndPage {
        dup 0 eq {
            pop pop true
        } {
            1 eq { pop true } { pop false } ifelse
        } ifelse
    } bind
    /InputAttributes <<>>
    /OutputAttributes <<>>
    /ColorModel /DeviceRGB
    /ProcessColorModel /DeviceRGB
    % The recovery policies for requests the device cannot satisfy (PLRM 6.2.7), as in
    % Ghostscript: ignore an unknown parameter, refuse a page size there is no medium for.
    /Policies << /PolicyNotFound 1 /PageSize 0 /PolicyReport {pop} bind >>
    /PageCount 0
    /.IsPageDevice true
    /Separations false
    /Colors 3
    /StrokeMethod /NativeStroke
>>
