%% pagedevice dictionary for pdf output device

<<
    /OutputDeviceName (pdf)
    /OutputDevice /pdf
    /PageSize [612 792]
    /HWResolution [300 300]
    /Margins [0.0 0.0]
    /PageOffset [0 0]
    % Stored but not applied, as in Ghostscript's raster devices: null is the whole page.
    /ImagingBBox null
    /BitsPerPixel 24
    /NumCopies null
    /Install {
        .9 setflat
        {} settransfer
    } bind
    /BeginPage {pop} bind
    /EndPage {
        %% count reason -> bool. Consume both operands (PLRM 6.2.6).
        exch pop
        2 ne %% showpage or copypage: produce the page; device deactivation: not
    } bind
    /InputAttributes <<>>
    /OutputAttributes <<>>
    /ColorModel /DeviceRGB
    /ProcessColorModel /DeviceRGB
    % Paint device colours through the Default* ColorSpace resources (PLRM 6.2.5).
    /UseCIEColor false
    % The recovery policies for requests the device cannot satisfy (PLRM 6.2.7), as in
    % Ghostscript: ignore an unknown parameter, refuse a page size there is no medium for.
    /Policies << /PolicyNotFound 1 /PageSize 0 /PolicyReport {pop} bind >>
    /PageCount 0
    /.IsPageDevice true
    /Separations false
    /Supported {}
    /RedValues 256
    /GreenValues 256
    /BlueValues 256
    /Colors 3
    /TextRenderingMode /GlyphPaths
    /StrokeMethod /NativeStroke
>>
